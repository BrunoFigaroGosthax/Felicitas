{
  "name": "felicitas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web de Felicitas, pediatría con propósito: landing, turnos y cursos.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=server/.env server/index.js",
    "build": "vite build && node --env-file-if-exists=.env scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test \"server/**/*.test.js\"",
    "test:db": "node supabase/tests/esquema.test.mjs",
    "check": "npm run lint && npm test && npm run test:db && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.8",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "tailwindcss": "4.1.8",
    "vite": "6.3.5"
  }
}

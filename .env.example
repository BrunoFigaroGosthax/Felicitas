# Frontend (Vite). Copiar a .env (no se sube a GitHub).

# true = la web funciona sola con datos de ejemplo y una sesión de prueba (sin backend ni Supabase).
VITE_USE_MOCKS=true

# Supabase: Project Settings → API. La anon key es pública (la protegen las políticas RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vacío: el frontend y la API están en el mismo dominio (Vercel). En local, el proxy de Vite.
VITE_API_URL=

# Dominio público, sin barra final (sitemap, vista previa al compartir). Ej.: https://www.ejemplo.com.ar
SITE_URL=

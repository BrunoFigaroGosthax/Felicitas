# Backend. Copiar a server/.env para desarrollo local (no se sube a GitHub).
# En producción, cargar las mismas variables en Vercel (Settings → Environment Variables).
# Cada integración se activa sola cuando están sus variables; si faltan, responde 503 o simula.

PORT=3001
# Dominio público, sin barra final (links de los emails y vuelta de Mercado Pago).
SITE_URL=http://localhost:5173

# Supabase (Project Settings → API). La service role key salta las políticas: NUNCA en el frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Tus integraciones → Credenciales y Webhooks). El secreto valida los avisos de pago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Bunny Stream (videos). Biblioteca → API: Library ID y API Key; Security → Token Authentication Key.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_API_KEY=

# Emails (Resend). Sin clave, se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM=Felicitas <no-responder@ejemplo.com>
# Recibe los avisos internos (botón de arrepentimiento).
EMAIL_ADMIN=

# Tareas programadas (recordatorios, sincronización de la agenda). Vercel lo manda solo a sus crons.
# Generar uno largo y al azar; el mismo valor va como secreto CRON_SECRET en GitHub si se usa el workflow "Agenda".
CRON_SECRET=
# Opcional: firma de los links para cancelar turnos. Si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY.
TOKEN_SECRET=

# Segundo sistema de turnos (pendiente: saber cuál es). Sin esto, no participa de la agenda.
OTRO_SISTEMA_API_URL=

# DrApp (pedirlas a DrApp). Sin ellas, horarios y reservas de ejemplo.
DRAPP_API_URL=
DRAPP_API_KEY=
